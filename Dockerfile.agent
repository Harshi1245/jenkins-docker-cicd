
FROM jenkins/inbound-agent:jdk17

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 \
       python3-venv \
       python3-pip \
       docker-cli \
       docker-buildx \
    && command -v docker \
    && docker --version \
    && rm -rf /var/lib/apt/lists/*

USER root
